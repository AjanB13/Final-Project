third-party video models we integrate may have different limitations, as they operate under different systems. We'll provide more information about availability and limitations for these models as they're added to the platform."})]})},{question:"Why does Video use more tokens?",answer:(0,t.jsxs)("div",{className:"text-secondary-foreground space-y-4",children:[(0,t.jsx)("p",{children:"Video models cost more tokens because they require significantly more GPU power to generate content. Processing video involves handling multiple frames per second, which is much more resource-intensive than generating a single image."}),(0,t.jsx)("p",{children:"Additionally, some video models are hosted by third parties, which means we don't control the infrastructure. These hosted models often have stricter usage limits and higher operating costs, which translates to more tokens per use."}),(0,t.jsx)("p",{children:'Our hosted models like WAN (and others) support unlimited generations in "Relaxed Generation" mode—so even if you run out of tokens, you can keep creating at a slower pace.'}),(0,t.jsx)("p",{children:" Note: Third-party video models do not allow unlimited video via relaxed generation."})]})},{question:"Can I use my generated images for commercial projects?",answer:(0,t.jsxs)("div",{className:"text-secondary-foreground",children:[(0,t.jsx)("p",{children:"Yes, you can. However, the rights to use generated images in commercial projects vary based on your subscription status:"}),(0,t.jsx)("p",{className:"mt-4",children:"Paid subscribers: You retain full ownership and intellectual property rights of your generated images and can use these creations for commercial projects."}),(0,t.jsx)("p",{className:"mt-4",children:"Free tier users: While Leonardo.Ai owns rights to the images you create, you're granted a non-exclusive, royalty-free licence to use your generated content for commercial purposes."})]})},{question:"Can I change my plan later?",answer:(0,t.jsx)("div",{className:"text-secondary-foreground",children:(0,t.jsx)("p",{children:"You could always choose to upgrade or downgrade to a more suitable plan for your needs. Upgrade will apply immediately and downgrade will apply once your billing cycle ends."})})},{question:"Does the pricing include tax?",answer:(0,t.jsx)("div",{className:"text-secondary-foreground",children:(0,t.jsx)("p",{children:"Pricing in this table excludes tax. Tax, if applicable, will be added at the point of payment with Stripe. If we do not currently charge GST or VAT in your country or region, and in future need to begin charging this after meeting a local threshold, then this will be added to your recurring bill at that time."})})},{question:"Will I be able to use my plan for API access?",answer:(0,t.jsx)("div",{className:"text-secondary-foreground",children:(0,t.jsxs)("p",{children:["We do offer an enterprise API solution. If you are interested in API access or need further details, please reach out to our Business Development team directly via our"," ",(0,t.jsx)("a",{target:"_blank",href:"https://leonardo.ai/contact-us/",rel:"noreferrer",className:"text-highlight-foreground hover:underline",children:"Contact Us"})," ","page. Our team would be more than happy to assist you with your specific needs."]})})},{question:"Can I buy more tokens if I run out?",answer:(0,t.jsx)("div",{className:"text-secondary-foreground",children:(0,t.jsxs)("ul",{className:"list-disc pl-5",children:[(0,t.jsx)("li",{children:"Token Top-up Packs are available to paid users only."}),(0,t.jsx)("li",{children:"Tokens never expire and are not capped. Users can buy multiple packs."}),(0,t.jsx)("li",{children:"Top-up Tokens are used after Rollover Tokens and Fast Tokens."})]})})}];var i=e.i(511415);let l=()=>{let e,n=(0,r.c)(1);return n[0]===Symbol.for("react.memo_cache_sentinel")?(e=(0,t.jsx)(i.Accordion,{collapsible:!0,type:"single",className:"**:data-[slot=accordion-trigger]:text-lg",children:a.map(o)}),n[0]=e):e=n[0],e};function o(e){let{ques